  });
  $$('.copyb').forEach(function (b) {
    var label = b.textContent;
    b.addEventListener('click', function () {
      copyText($('pre code', b.closest('.copyable')).textContent, b, label, 'ok');
    });
  });

  /* ---------- Which collection? decision guide ---------- */
  var scenarios = [
    { t: 'Store the results of a SOQL query, in the order returned', c: 'list', b: 'List',
      w: 'SOQL always returns a List, and a List preserves the order records came back in.' },
    { t: 'Keep every Contact email a Case has been sent to, without repeats', c: 'set', b: 'Set',
      w: 'You only care whether an email has already been used, not how many times — a Set removes duplicates automatically.' },
    { t: 'Collect unique Account Ids from a loop before one bulk SOQL query', c: 'set', b: 'Set<Id>',
      w: 'This is the classic bulk-safe pattern: gather unique Ids in a Set, then query once with WHERE Id IN :theSet.' },
    { t: 'Look up an Account\'s Name instantly by its Id, many times', c: 'map', b: 'Map<Id, Account>',
      w: 'A Map gives you near-instant lookups by key instead of looping through a List every time you need one record.' },
    { t: 'Allow the same customer name to appear more than once in a report list', c: 'list', b: 'List',
      w: 'Duplicates are allowed and order matters for a report — that is exactly what a List is for.' },
    { t: 'Check quickly whether a given Case Id has already been processed', c: 'set', b: 'Set<Id>',
      w: 'A Set\'s contains() check is fast and is built exactly for "have I seen this before?" logic.' }
  ];
  var scnsEl = $('#scns'), resultEl = $('#result');
  scenarios.forEach(function (s) {
    var b = document.createElement('button');
    b.type = 'button'; b.className = 'scn'; b.textContent = s.t;
    b.addEventListener('click', function () {
      $$('.scn', scnsEl).forEach(function (x) { x.classList.toggle('on', x === b); });
      resultEl.innerHTML = '<span class="badge ' + s.c + '">' + s.b + '</span><p>' + s.w + '</p>';
    });
    scnsEl.appendChild(b);
  });

  /* ---------- Quiz ---------- */
  var questions = [
    { q: 'Which type should you use to store a monetary value safely?',
      o: ['Double', 'Decimal', 'Long', 'String'], a: 1,
      why: 'Decimal is fixed-point and avoids the rounding surprises that Double can introduce with money.' },
    { q: 'Which collection removes duplicate values automatically?',
      o: ['List', 'Set', 'Map', 'Array'], a: 1,
      why: 'A Set only keeps unique values — adding a duplicate is silently ignored.' },
    { q: 'What happens to the automatic no-argument constructor once you write your own custom constructor?',
      o: ['Nothing, both are always available', 'It is removed — you must define one yourself if you still need it', 'It becomes private', 'It only works in tests'], a: 1,
      why: 'As soon as you add any constructor of your own, Apex stops providing the free no-argument one automatically.' },
    { q: 'Which access modifier is the default when you write no modifier at all?',
      o: ['public', 'global', 'private', 'protected'], a: 2,
      why: 'If you omit an access modifier, Apex treats the member as private by default.' },
    { q: 'You need to look up an Account by Id many times inside a method. What is the best choice?',
      o: ['Loop through a List each time', 'Use a Map<Id, Account>', 'Use a Set<Id>', 'Run a new SOQL query each time'], a: 1,
      why: 'A Map keyed by Id gives near-instant lookups instead of repeatedly looping or re-querying.' }
  ];
  var qi = 0, score = 0, quizEl = $('#quiz');
  function renderQ() {
    if (qi >= questions.length) {
      quizEl.innerHTML = '<h2>Quiz complete</h2><div class="score">' + score + ' / ' + questions.length + '</div>' +
        '<p class="body">' + (score === questions.length ? 'Perfect score. You have Apex Basics I down cold.' : 'Good effort. Revisit the topics you missed using the Slides button.') + '</p>' +
        '<button class="btn" type="button" id="qRetry">Try again</button>';
      $('#qRetry').addEventListener('click', function () { qi = 0; score = 0; renderQ(); });
      return;
    }
    var q = questions[qi];
    var h = '<div class="meter-label">Question ' + (qi + 1) + ' of ' + questions.length + '</div><div class="qtext">' + q.q + '</div>';
    q.o.forEach(function (t, i) { h += '<button class="opt" type="button" data-i="' + i + '">' + t + '</button>'; });
    h += '<div class="feedback" id="fb" aria-live="polite"></div><div class="row"><button class="btn" type="button" id="qNext" style="display:none">' + (qi === questions.length - 1 ? 'See score' : 'Next question') + '</button></div>';
    quizEl.innerHTML = h;
    $$('.opt', quizEl).forEach(function (b) {
      b.addEventListener('click', function () {
        var pick = parseInt(b.getAttribute('data-i'), 10);
        $$('.opt', quizEl).forEach(function (x, i) {
          x.disabled = true;
          if (i === q.a) x.classList.add('right');
          else if (i === pick) x.classList.add('wrong');
        });
        if (pick === q.a) score++;
        $('#fb').textContent = (pick === q.a ? 'Correct. ' : 'Not quite. ') + q.why;
        $('#qNext').style.display = 'inline-block';
      });
    });
    $('#qNext').addEventListener('click', function () { qi++; renderQ(); });
  }
  renderQ();

  /* ---------- YouTube recording link ---------- */
  var YOUTUBE_VIDEO_ID = ""; // paste the video ID here once the recording is live, e.g. "abc123XYZ_0"
  if (YOUTUBE_VIDEO_ID && YOUTUBE_VIDEO_ID.trim()) {
    var wl = $('#watchLink');
    wl.href = 'https://www.youtube.com/watch?v=' + YOUTUBE_VIDEO_ID.trim();
    wl.style.display = 'inline-flex';
    $('#watchSoon').style.display = 'none';
  }

  /* ---------- Start ---------- */
  var start = parseInt((location.hash || '').replace('#', ''), 10);
  go(isNaN(start) ? 0 : start - 1);
})();
</script>
</body>
</html>
