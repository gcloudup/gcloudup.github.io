    --card-bg: #FFFFFF;
    --page-bg: #F6FAFD;
    --border: #E1EBF3;
    --head: #032D60;
    --shadow: 0 4px 18px rgba(3,45,96,0.07);
    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --card-bg: #0E2A47; --page-bg: #071C33; --ink: #E7F2FA; --head: #E7F2FA;
      --muted: #9FC2DC; --border: #163A5C; --sky: #0E3357;
      --shadow: 0 4px 18px rgba(0,0,0,0.35);
    }
  }
  :root[data-theme="dark"] {
    --card-bg: #0E2A47; --page-bg: #071C33; --ink: #E7F2FA; --head: #E7F2FA;
    --muted: #9FC2DC; --border: #163A5C; --sky: #0E3357;
    --shadow: 0 4px 18px rgba(0,0,0,0.35);
  }
  html { scroll-padding-top: env(safe-area-inset-top, 0px); height: 100%; }
  * { box-sizing: border-box; }
  body {
    margin: 0; height: 100%; overflow: hidden;
    font-family: Calibri, -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
    background: var(--page-bg); color: var(--ink);
    -webkit-font-smoothing: antialiased;
  }
  button { font-family: inherit; color: inherit; }
  :focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; }

  /* ---------- App shell ---------- */
  .app { height: 100%; display: flex; flex-direction: column; min-height: 0; }
  .bar {
    display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
    padding: 0.6rem 1rem; background: var(--card-bg); flex: 0 0 auto;
  }
  .bar.top { border-bottom: 1px solid var(--border); }
  .bar.bottom { border-top: 1px solid var(--border); }
  .brand {
    display: flex; align-items: center; gap: 0.5rem; min-width: 0;
    font-family: Cambria, serif; font-weight: 700; font-size: 0.92rem; color: var(--head);
  }
  .brand .mark {
    width: 26px; height: 26px; border-radius: 7px; background: var(--blue); color: #fff;
    display: flex; align-items: center; justify-content: center; font-size: 0.75rem; flex: 0 0 auto;
  }
  .brand .name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .brand .sub { color: var(--muted); font-family: Calibri, sans-serif; font-weight: 600; font-size: 0.8rem; }
  .tools { display: flex; gap: 0.4rem; flex: 0 0 auto; }
  .iconbtn {
    display: inline-flex; align-items: center; gap: 0.35rem;
    background: var(--sky); color: var(--blue); border: none; cursor: pointer;
    font-weight: 700; font-size: 0.78rem; padding: 0.45rem 0.7rem; border-radius: 8px;
  }
  .iconbtn.on { background: var(--blue); color: #fff; }
  .iconbtn svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }

  .progress { height: 4px; background: var(--border); flex: 0 0 auto; }
  .progress span { display: block; height: 100%; width: 0; background: var(--blue); transition: width 0.25s ease; }

  .stage { position: relative; flex: 1 1 auto; min-height: 0; }
  .slide {
    display: none; position: absolute; inset: 0; overflow-y: auto; overflow-x: hidden;
    padding: clamp(1rem, 3.5vw, 2.75rem);
  }
  .slide.active { display: flex; animation: fadein 0.28s ease; }
  @keyframes fadein { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .slide.active { animation: none; }
    .progress span, .scn { transition: none !important; }
  }
  .slide-inner { margin: auto; width: 100%; max-width: 1020px; }

  /* ---------- Type ---------- */
  .chip {
    display: inline-block; background: var(--sky); color: var(--blue);
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
    padding: 0.3rem 0.7rem; border-radius: 999px; margin-bottom: 0.8rem;
  }
  h1, h2, h3, h4 { font-family: Cambria, Georgia, serif; color: var(--head); margin: 0; }
  h1 { font-size: clamp(1.9rem, 6vw, 3.4rem); line-height: 1.15; }
  h2 { font-size: clamp(1.4rem, 3.8vw, 2.3rem); line-height: 1.2; margin-bottom: 0.7rem; }
  h3 { font-size: clamp(1.05rem, 2.2vw, 1.3rem); margin-bottom: 0.3rem; }
  h4 { font-size: 1.05rem; margin-bottom: 0.3rem; }
  p { margin: 0 0 0.9rem; }
  .lead { font-size: clamp(1rem, 2vw, 1.25rem); line-height: 1.6; color: var(--muted); max-width: 62ch; margin-bottom: 1.2rem; }
  .body { font-size: clamp(0.95rem, 1.7vw, 1.1rem); line-height: 1.65; }
  code { background: var(--sky); color: var(--head); padding: 0.1rem 0.4rem; border-radius: 5px; font-size: 0.9em; }

  /* ---------- Title slide ---------- */
  .slide.hero {
    background: linear-gradient(135deg, #032D60 0%, #0B3D73 55%, #00A1E0 100%);
    color: #fff; overflow: hidden;
  }
  .slide.hero h1, .slide.hero .lead { color: #fff; }
  .slide.hero .lead { color: #CFE9FB; }
  .slide.hero .chip { background: rgba(255,255,255,0.14); color: #CFE9FB; }
  .hero-decor { position: absolute; border-radius: 50%; background: rgba(255,255,255,0.08); pointer-events: none; }
  .hero-decor.a { width: 340px; height: 340px; top: -130px; right: -90px; }
  .hero-decor.b { width: 220px; height: 220px; bottom: -90px; left: -50px; background: rgba(255,255,255,0.06); }
  .hero .slide-inner { position: relative; }
  .cta {
    display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 0.5rem;
    background: #fff; color: #032D60; border: none; cursor: pointer; font-weight: 700;
    font-size: 0.95rem; padding: 0.75rem 1.4rem; border-radius: 999px;
  }
  .cta svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2.4; }
  .hint { margin-top: 1.4rem; font-size: 0.8rem; color: #9FC2DC; }

  .yt-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin-top: 1.2rem; }
  .yt-link {
    display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none;
    font-weight: 700; font-size: 0.85rem; padding: 0.6rem 1.1rem; border-radius: 999px;
  }
  .yt-link svg { width: 16px; height: 16px; fill: currentColor; }
  .yt-link.watch { background: #FF0000; color: #fff; }
  .yt-link.subscribe { background: rgba(255,255,255,0.14); color: #fff; border: 2px solid rgba(255,255,255,0.6); }
  .yt-link.subscribe:hover { background: #fff; color: #FF0000; }
  .yt-soon { color: #CFE9FB; font-size: 0.85rem; }

  /* ---------- Cards / grids ---------- */
  .grid { display: grid; gap: 0.85rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .card {
    background: var(--card-bg); border: 1px solid var(--border); border-radius: 14px;
    padding: 1rem 1.1rem; box-shadow: var(--shadow);
  }
  .card p { margin: 0; color: var(--muted); font-size: 0.92rem; line-height: 1.55; }
  button.card { text-align: left; cursor: pointer; width: 100%; }
  button.card:hover { border-color: var(--blue); }
  .agenda .num {
    width: 32px; height: 32px; border-radius: 50%; background: var(--blue); color: #fff;
    display: flex; align-items: center; justify-content: center; font-weight: 700; margin-bottom: 0.6rem;
  }
  .agenda h3 { font-size: 1.1rem; }
  .card.accent-coral { border-top: 4px solid var(--coral); }
  .card.accent-blue { border-top: 4px solid var(--blue); }
  .card.accent-gold { border-top: 4px solid var(--gold); }
  .card.accent-green { border-top: 4px solid var(--green); }
  .row { display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: center; margin-top: 0.8rem; }
  .btn {
    background: var(--blue); color: #fff; border: none; border-radius: 8px; cursor: pointer;
    font-weight: 700; font-size: 0.85rem; padding: 0.55rem 1rem;
  }
  .btn.ghost { background: var(--sky); color: var(--blue); }
  a.btn { text-decoration: none; display: inline-block; }
  .btn.subscribe { background: #FF0000; color: #fff; }
  .btn.ok { background: var(--green); color: #fff; }

  /* ---------- Tabs ---------- */
  .tabs { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.9rem; }
  .tab {
    background: var(--sky); color: var(--blue); border: none; border-radius: 999px; cursor: pointer;
    font-weight: 700; font-size: 0.88rem; padding: 0.5rem 1rem;
  }
  .tab.on { background: var(--blue); color: #fff; }
  .panel { background: var(--card-bg); border: 1px solid var(--border); border-radius: 14px; padding: 1.1rem 1.3rem; box-shadow: var(--shadow); }
  .panel[hidden] { display: none; }
  .panel dl { margin: 0; display: grid; grid-template-columns: max-content 1fr; gap: 0.5rem 1rem; }
  .panel dt { font-weight: 700; color: var(--blue); }
  .panel dd { margin: 0; line-height: 1.55; }
  @media (max-width: 520px) { .panel dl { grid-template-columns: 1fr; gap: 0.1rem; } .panel dd { margin-bottom: 0.6rem; } }

  /* ---------- Table ---------- */
  .tablewrap { overflow-x: auto; border: 1px solid var(--border); border-radius: 14px; background: var(--card-bg); box-shadow: var(--shadow); }
  table { border-collapse: collapse; width: 100%; min-width: 520px; font-size: 0.95rem; }
  th, td { text-align: left; padding: 0.7rem 1rem; border-bottom: 1px solid var(--border); vertical-align: top; }
  th { background: var(--navy); color: #fff; font-size: 0.82rem; }
  tr:last-child td { border-bottom: none; }
  tbody tr:hover td { background: var(--sky); }
  td:first-child { font-weight: 700; color: var(--head); }

  /* ---------- Code ---------- */
  .cmd {
    display: flex; align-items: center; justify-content: space-between; gap: 0.6rem;
    background: var(--navy); color: #E7F2FA; border-radius: 10px; padding: 0.6rem 0.6rem 0.6rem 1rem; margin-bottom: 0.5rem;
  }
  .cmd code { background: none; color: inherit; padding: 0; font-size: 0.9rem; overflow-x: auto; white-space: nowrap; }
  .cmd .why { display: block; color: #8AA9C2; font-size: 0.78rem; font-family: Calibri, sans-serif; margin-top: 0.15rem; white-space: normal; }
  .copy {
    background: rgba(255,255,255,0.14); color: #fff; border: none; border-radius: 7px; cursor: pointer;
    font-weight: 700; font-size: 0.75rem; padding: 0.4rem 0.7rem; flex: 0 0 auto;
  }
  .copy.ok { background: var(--green); }
  pre.code {
    background: var(--navy); color: #E7F2FA; border-radius: 10px; padding: 1rem 1.1rem; overflow-x: auto;
    font-size: 0.88rem; line-height: 1.6; margin: 0 0 0.6rem;
  }
  pre.code code { background: none; color: inherit; padding: 0; }
  .note { color: var(--muted); font-size: 0.9rem; line-height: 1.55; margin: 0.4rem 0 0; }
  .steps { margin: 0 0 0.6rem; padding-left: 1.2rem; line-height: 1.6; }

  /* ---------- Decision guide ---------- */
  .split { display: grid; gap: 1rem; grid-template-columns: 1.15fr 1fr; align-items: start; }
  @media (max-width: 760px) { .split { grid-template-columns: 1fr; } }
  .scns { display: flex; flex-direction: column; gap: 0.45rem; }
  .scn {
    text-align: left; cursor: pointer; border: 1px solid var(--border); border-radius: 10px;
    padding: 0.65rem 0.9rem; font-size: 0.93rem; line-height: 1.4; background: var(--card-bg);
    transition: border-color 0.15s ease;
  }
  .scn:hover { border-color: var(--blue); }
  .scn.on { border-color: var(--blue); box-shadow: inset 4px 0 0 var(--blue); background: var(--sky); }
  .result { min-height: 170px; }
  .badge {
    display: inline-block; font-weight: 700; font-size: 0.8rem; color: #fff; border-radius: 999px;
    padding: 0.25rem 0.75rem; margin-bottom: 0.6rem;
  }
  .badge.list { background: var(--blue); }
  .badge.set { background: var(--coral); }
  .badge.map { background: #C98A1B; }
  .result p { color: var(--ink); font-size: 0.97rem; line-height: 1.6; margin: 0; }

  /* ---------- Quiz ---------- */
  .qtext { font-family: Cambria, serif; font-size: clamp(1.1rem, 2.4vw, 1.4rem); color: var(--head); margin-bottom: 0.9rem; }
  .opt {
    display: block; width: 100%; text-align: left; cursor: pointer; margin-bottom: 0.5rem;
    background: var(--card-bg); border: 2px solid var(--border); border-radius: 10px;
    padding: 0.7rem 1rem; font-size: 0.98rem; line-height: 1.45;
  }
  .opt:hover:not(:disabled) { border-color: var(--blue); }
  .opt.right { border-color: var(--green); background: rgba(46,158,107,0.12); }
  .opt.wrong { border-color: var(--coral); background: rgba(255,107,74,0.12); }
  .opt:disabled { cursor: default; }
  .feedback { min-height: 2.6rem; line-height: 1.5; color: var(--muted); }
  .score { font-family: Cambria, serif; font-size: 2rem; color: var(--blue); }
  .meter-label { font-size: 0.85rem; color: var(--muted); margin-bottom: 0.35rem; font-weight: 700; }

  /* ---------- Notes and overview ---------- */
  .notes {
    display: none; flex: 0 0 auto; max-height: 26%; overflow-y: auto; padding: 0.7rem 1rem;
    background: var(--sky); border-top: 1px solid var(--border); font-size: 0.92rem; line-height: 1.55;
  }
  .notes.open { display: block; }
  .notes b { color: var(--blue); }
  .overview {
    position: absolute; inset: 0; z-index: 20; background: var(--page-bg); overflow-y: auto;
    padding: 1.2rem; display: none;
  }
  .overview.open { display: block; }
  .overview h2 { margin-bottom: 1rem; }
  .ov-grid { display: grid; gap: 0.7rem; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); }
  .ov-item {
    text-align: left; cursor: pointer; background: var(--card-bg); border: 2px solid var(--border);
    border-radius: 12px; padding: 0.8rem 0.9rem; font-size: 0.9rem; font-weight: 700; line-height: 1.35;
  }
  .ov-item small { display: block; color: var(--blue); margin-bottom: 0.2rem; }
  .ov-item.cur { border-color: var(--blue); background: var(--sky); }

  /* ---------- Bottom nav ---------- */
  .nav { display: flex; align-items: center; gap: 0.6rem; }
  .navbtn {
    display: inline-flex; align-items: center; gap: 0.4rem; background: var(--navy); color: #fff; border: none;
    border-radius: 999px; cursor: pointer; font-weight: 700; font-size: 0.85rem; padding: 0.55rem 1.1rem;
  }
  .navbtn:disabled { opacity: 0.35; cursor: default; }
  .navbtn svg { width: 14px; height: 14px; fill: none; stroke: #fff; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .counter { font-weight: 700; font-size: 0.88rem; color: var(--muted); min-width: 4.5rem; text-align: center; }
  .keys { color: var(--muted); font-size: 0.75rem; }
  @media (max-width: 720px) { .keys, .brand .sub { display: none; } .iconbtn .lbl { display: none; } }
</style>
